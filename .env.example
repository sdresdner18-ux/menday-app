# App runtime — Supabase pooler (Settings → Database → Connection string → Transaction pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma db push / migrations — direct connection (Settings → Database → URI, port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional: comma-separated emails allowed to sign in (leave empty to allow all)
ALLOWED_EMAILS="you@yourshop.com"

# Optional: shop WhatsApp number for customer tracking page contact button
NEXT_PUBLIC_SHOP_PHONE="5551234567"

# Optional: secret for signing tracking verification cookies (defaults to DATABASE_URL)
TRACKING_COOKIE_SECRET="your-random-secret"
